# Modelo de variáveis de ambiente (copie para .env.local e preencha).
# .env.local NÃO é versionado; este .env.example é só documentação.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # publishable key (browser)

# Server-only (NÃO usar no navegador) — preenchido em fases posteriores:
# SUPABASE_SECRET_KEY=sb_secret_xxx                # apuração/admin (service-side)
# API_FOOTBALL_KEY=xxx                             # Fase 8
